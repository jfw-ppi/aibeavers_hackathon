FROM node:22-bookworm-slim

WORKDIR /app
ENV CI=true \
    NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@11.5.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY patches ./patches
COPY packages ./packages
COPY apps/web ./apps/web
COPY src ./src
COPY berater-config.json demo-transcript.json ./

# NEXT_PUBLIC_* is inlined into the client bundle at BUILD time. The server route
# reads it at runtime, so it must be present here (before `pnpm build`) — otherwise
# the client sends the default recipient while the server expects the override and
# the live-send allowlist silently rejects → mock fallback on stage. ENV (set before
# the build) covers both the build-time inline and runtime. Empty → demo-config falls
# back to the default. Pass via: docker build --build-arg NEXT_PUBLIC_DEMO_RECIPIENT_EMAIL=…
ARG NEXT_PUBLIC_DEMO_RECIPIENT_EMAIL=
ENV NEXT_PUBLIC_DEMO_RECIPIENT_EMAIL=$NEXT_PUBLIC_DEMO_RECIPIENT_EMAIL

RUN pnpm config set dangerouslyAllowAllBuilds true \
  && pnpm install --frozen-lockfile \
  && pnpm --filter web build

WORKDIR /app/apps/web
ENV HOSTNAME=0.0.0.0 \
    PORT=3000 \
    USE_MOCK_ANALYSIS=true \
    ALLOW_LIVE_ACTION_EXECUTION=false

EXPOSE 3000
CMD ["pnpm", "start"]
